<mjml>
  <mj-head>
    <!-- Email Subject Preview -->
    <mj-preview>
      Limited-time offer on handcrafted ceramic mugs. Shop now before it's gone.
    </mj-preview>

    <!-- Breakpoint -->
    <mj-breakpoint width="480px" />

    <!-- Email Title -->
    <mj-title>Obsidian Ceramic Mug – Special Offer</mj-title>

    <!-- Google Font -->
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />

    <!--
    ================================================
      COLOR SYSTEM
    ================================================

      LIGHT MODE
      ----------
      Email outer bg        → #f4f4f4
      Section bg            → #ffffff
      Card bg               → #f8f8f8
      Border                → #e8e8e8
      Heading               → #111111
      Subheading            → #444444
      Body text             → #666666
      Muted                 → #888888
      Footer text           → #999999

      DARK MODE
      ----------
      Email outer bg        → #111111
      Section bg            → #1a1a1a
      Card bg               → #222222
      Border                → #333333
      Heading               → #f0f0f0
      Subheading            → #cccccc
      Body text             → #aaaaaa
      Muted                 → #888888
      Footer text           → #666666

      ACCENT (both modes)
      -------------------
      Primary green         → #1a5c38
      Amber                 → #c97d2e

      DIVIDERS
      --------
      Light                 → #e8e8e8  (dark: #333333)
      Strong                → #cccccc  (dark: #444444)
    ================================================
    -->
    <!-- Global Attributes -->
    <mj-attributes>
      <!-- Entire Email -->
      <mj-all
        font-family="'Inter', Georgia, 'Times New Roman', Arial, serif"
        color="#444444"
        line-height="1.5"
      />

      <!-- Body -->
      <mj-body background-color="#f4f4f4" />

      <!-- Sections -->
      <mj-section padding="0" background-color="#ffffff" />

      <!-- Columns -->
      <mj-column padding="0" />

      <!-- Text -->
      <mj-text
        padding="0"
        font-size="16px"
        line-height="24px"
        color="#444444"
      />

      <!-- Buttons — primary default -->
      <mj-button
        border-radius="4px"
        font-size="14px"
        font-weight="600"
        inner-padding="14px 28px"
        padding="0"
        background-color="#111111"
        color="#ffffff"
      />

      <!-- Images -->
      <mj-image padding="0" border="0" fluid-on-mobile="true" />

      <!-- Divider -->
      <mj-divider
        border-style="solid"
        border-color="#e8e8e8"
        border-width="1px"
        width="100%"
        align="left"
        padding="15px 0"
      />
    </mj-attributes>

    <!-- STYLE BLOCK 1: Inlined regular styles -->
    <mj-style inline="inline">
      a {
        text-decoration: none;
      }
      img {
        display: block;
        border: 0;
        outline: none;
        text-decoration: none;
      }
      p {
        margin: 0;
        padding: 0;
      }
    </mj-style>

    <!--
      STYLE BLOCK 2: Dark mode — NOT inlined
      ----------------------------------------
      MJML compiles to nested tables. Background sits on
      multiple levels: div > table > tbody > tr > td.
      We must target ALL levels with !important to override
      the hardcoded inline background-color attributes.

      Same for text: MJML puts color as inline style on the
      wrapping div. We target div, p, span, a with !important.

      CSS CLASSES USED:
      dm-bg-outer    → outer email body
      dm-bg-section  → white sections (#ffffff → #1a1a1a)
      dm-bg-card     → card sections (#f8f8f8 → #222222)
      dm-text-h      → headings
      dm-text-sub    → subheadings / feature list
      dm-text-body   → body / description text
      dm-text-muted  → muted / subtitle text
      dm-text-footer → footer text
      dm-text-nav    → navbar links
      dm-text-link   → inline links
      dm-btn-primary → primary button (inverts)
      dm-div-light   → light divider
      dm-div-strong  → strong divider
      dm-table-row   → table data rows
    -->

    <mj-style>
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }

      @media (prefers-color-scheme: dark) {
        /* ── Outer email background ── */
        body,
        .dm-bg-outer,
        .dm-bg-outer > div,
        .dm-bg-outer > table,
        .dm-bg-outer > table > tbody > tr > td {
          background-color: #111111 !important;
        }

        /* ── White section backgrounds ── */
        .dm-bg-section,
        .dm-bg-section > div,
        .dm-bg-section > table,
        .dm-bg-section > table > tbody > tr > td,
        .dm-bg-section td {
          background-color: #1a1a1a !important;
        }

        .dm-bg-section-soft,
        .dm-bg-section-soft > div,
        .dm-bg-section-soft > table,
        .dm-bg-section-soft > table > tbody > tr > td,
        .dm-bg-section-soft td {
          background-color: #141414 !important;
        }

        /* ── Card / gray section backgrounds ── */
        .dm-bg-card,
        .dm-bg-card > div,
        .dm-bg-card > table,
        .dm-bg-card > table > tbody > tr > td,
        .dm-bg-card td {
          background-color: #222222 !important;
          border-color: #333333 !important;
        }

        /* ── Headings ── */
        .dm-text-h,
        .dm-text-h div,
        .dm-text-h p,
        .dm-text-h span,
        .dm-text-h a {
          color: #f0f0f0 !important;
        }

        /* ── Subheadings / feature list ── */
        .dm-text-sub,
        .dm-text-sub div,
        .dm-text-sub p,
        .dm-text-sub span,
        .dm-text-sub a {
          color: #cccccc !important;
        }

        /* ── Body / description text ── */
        .dm-text-body,
        .dm-text-body div,
        .dm-text-body p,
        .dm-text-body span,
        .dm-text-body a {
          color: #aaaaaa !important;
        }

        /* ── Muted / subtitle text ── */
        .dm-text-muted,
        .dm-text-muted div,
        .dm-text-muted p,
        .dm-text-muted span,
        .dm-text-muted a {
          color: #888888 !important;
        }

        /* ── Footer text ── */
        .dm-text-footer,
        .dm-text-footer div,
        .dm-text-footer p,
        .dm-text-footer span,
        .dm-text-footer a {
          color: #666666 !important;
        }

        /* ── Navbar links ── */
        .dm-text-nav,
        .dm-text-nav div,
        .dm-text-nav div a,
        .dm-text-nav a {
          color: #aaaaaa !important;
        }

        /* ── Inline links ── */
        .dm-text-link,
        .dm-text-link div,
        .dm-text-link div a,
        .dm-text-link a {
          color: #f0f0f0 !important;
        }

        /* ── Primary button: invert to light in dark mode ── */
        .dm-btn-primary table,
        .dm-btn-primary table td,
        .dm-btn-primary table td a {
          background-color: #f0f0f0 !important;
          color: #111111 !important;
        }

        /* ── Light divider ── */
        .dm-div-light p,
        .dm-div-light div,
        .dm-div-light td {
          border-color: #333333 !important;
        }

        /* ── Strong divider ── */
        .dm-div-strong p,
        .dm-div-strong div,
        .dm-div-strong td {
          border-color: #444444 !important;
        }

        /* ── Table data rows ── */
        .dm-table-row td {
          color: #aaaaaa !important;
          border-color: #333333 !important;
        }
      }
    </mj-style>

    <!-- Raw meta tags -->
    <mj-raw>
      <meta charset="UTF-8" /> <meta http-equiv="X-UA-Compatible"
      content="IE=edge" /> <meta name="viewport" content="width=device-width,
      initial-scale=1.0" /> <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" /> <meta
      name="format-detection" content="telephone=no, date=no, address=no,
      email=no, url=no" /> <meta name="x-apple-disable-message-reformatting" />
      <meta http-equiv="List-Unsubscribe"
      content="<mailto:unsubscribe@example.com?subject=unsubscribe>,
      <https://example.com/unsubscribe>" />
    </mj-raw>
  </mj-head>

  <mj-body width="600px" background-color="#f4f4f4" css-class="dm-bg-outer">
    <!-- ============================================================ -->
    <!-- LOGO                                                          -->
    <!-- ============================================================ -->
    <mj-section background-color="#ffffff" css-class="dm-bg-section">
      <mj-column vertical-align="top">
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778770594/email-portfolio/welcome-email-taskly/images/taskly-logo_n2tzl3.png"
          alt="Ultimate Technology Limited"
          href="https://taqwaitagency.com"
          padding="16px 0"
          width="140px"
        />
      </mj-column>
    </mj-section>

    <!--
    mj spacer
    For creating horizontal space between sections
    -->
    <mj-section css-class="dm-bg-section">
      <mj-column>
        <mj-spacer height="20px" />
      </mj-column>
    </mj-section>

    <!-- Taskly banner -->
    <mj-section css-class="dm-bg-section">
      <mj-column>
        <mj-text
          css-class="dm-text-h"
          font-weight="800"
          align="center"
          line-height="1.4"
          font-size="28px"
          color="#666666"
          text-transform="uppercase"
        >
          Welcome to <br />
          Taskly!
        </mj-text>
        <mj-text
          align="center"
          font-weight="500"
          padding="15px 0"
          line-height="1.6"
        >
          We are excited to have you on board!<br />
          Let's help you get started
        </mj-text>
        <mj-button
          padding="10px 0px"
          inner-padding="10px 18px"
          text-transform="uppercase"
          font-size="14px"
          background-color="#1b72e4"
        >
          Get started
        </mj-button>
        <mj-image
          padding="30px 0px 0px"
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778770594/email-portfolio/welcome-email-taskly/images/welcome_xbflp5.png"
          alt="Taskly welcome email"
        />
      </mj-column>
    </mj-section>

    <!-- Workspace, task, and features -->
    <mj-section
      padding="30px 15px 0px"
      background-color="#ffffff"
      css-class="dm-bg-section"
    >
      <mj-group width="420px">
        <mj-column width="15%" vertical-align="middle">
          <mj-image
            fluid-on-mobile="true"
            src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778772301/email-portfolio/welcome-email-taskly/icons/workspace-taskly_cmoztj.png"
            alt="Taskly workspace"
            width="50px"
            padding="0px"
          />
        </mj-column>
        <mj-column width="85%" padding="0px 20px" vertical-align="middle">
          <mj-text font-size="16px" font-weight="bold" css-class="dm-text-h">
            Create Your Workspace
          </mj-text>
          <mj-text font-size="13px" font-weight="500" css-class="dm-text-h">
            Setup your space and invite your team
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <!-- MJML divider -->
    <mj-section padding="15px" css-class="dm-bg-section">
      <mj-column width="420px">
        <mj-divider padding="0" width="100%" align="center" />
      </mj-column>
    </mj-section>

    <mj-section
      padding="0px 15px 0px"
      background-color="#ffffff"
      css-class="dm-bg-section"
    >
      <mj-group width="420px">
        <mj-column width="15%" vertical-align="middle">
          <mj-image
            fluid-on-mobile="true"
            src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778772300/email-portfolio/welcome-email-taskly/icons/task-taskly_i2nbxf.png"
            alt="Taskly workspace"
            width="50px"
            padding="0px"
          />
        </mj-column>
        <mj-column width="85%" padding="0px 20px" vertical-align="middle">
          <mj-text font-size="16px" font-weight="bold" css-class="dm-text-h">
            Add Your First Task
          </mj-text>
          <mj-text font-size="13px" font-weight="500" css-class="dm-text-h">
            Plan, organize, and get things done
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <!-- MJML divider -->
    <mj-section padding="15px" css-class="dm-bg-section">
      <mj-column width="420px">
        <mj-divider padding="0" width="100%" align="right" />
      </mj-column>
    </mj-section>

    <mj-section
      padding="0px 15px 30px"
      background-color="#ffffff"
      css-class="dm-bg-section"
    >
      <mj-group width="420px">
        <mj-column width="15%" vertical-align="middle">
          <mj-image
            fluid-on-mobile="true"
            src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778772301/email-portfolio/welcome-email-taskly/icons/feature-taskly_mfczba.png"
            alt="Taskly workspace"
            width="50px"
            padding="0px"
          />
        </mj-column>
        <mj-column width="85%" padding="0px 20px" vertical-align="middle">
          <mj-text font-size="16px" font-weight="bold" css-class="dm-text-h">
            Explore Features
          </mj-text>
          <mj-text font-size="13px" font-weight="500" css-class="dm-text-h">
            Discover peaceful features built for productivity
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <mj-section
      background-color="#f3f5fa"
      padding="20px 0px"
      css-class="dm-bg-section-soft"
    >
      <mj-column>
        <mj-text
          align="center"
          font-size="14px"
          font-weight="500"
          css-class="dm-text-h"
        >
          <span>Need help? Visit our help center</span> <br />
          or reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
